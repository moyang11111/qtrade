{
  "name": "qtrade-desktop",
  "version": "1.0.0",
  "description": "QTrade Desktop - A-share trading terminal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/runtime.test.js",
    "lint": "node --check main.js && node --check preload.js && node --check runtime.js",
    "dist:dir": "electron-builder --win dir",
    "dist:win": "electron-builder --win nsis",
    "build": "npm run dist:win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.qtrade.desktop",
    "productName": "QTrade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "runtime.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../server.py",
        "to": "qtrade/server.py"
      },
      {
        "from": "../qtrade_base_bridge.py",
        "to": "qtrade/qtrade_base_bridge.py"
      },
      {
        "from": "../qtrade_adapters",
        "to": "qtrade/qtrade_adapters",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../qtrade_factors",
        "to": "qtrade/qtrade_factors",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../factors.py",
        "to": "qtrade/factors.py"
      },
      {
        "from": "../paper_trading",
        "to": "qtrade/paper_trading",
        "filter": [
          "**/*.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../static",
        "to": "qtrade/static"
      },
      {
        "from": "../configs",
        "to": "qtrade/configs"
      },
      {
        "from": "../qtrade.ico",
        "to": "qtrade/qtrade.ico"
      }
    ],
    "win": {
      "icon": "../qtrade.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
